# Copy to .env and fill in.

# Required by SEC: identify yourself with a name and contact email.
# https://www.sec.gov/os/accessing-edgar-data
TR_SEC_USER_AGENT="TrackRecord your-name your-email@example.com"

# Optional: require `Authorization: Bearer <token>` on API requests.
# TR_API_TOKEN=change-me

# Optional: how far back to sync filings (default 2021-01-01).
# TR_HISTORY_START=2021-01-01
