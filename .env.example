# Copy to .env and fill in.

# Required by SEC: identify yourself with a name and contact email.
# https://www.sec.gov/os/accessing-edgar-data
TR_SEC_USER_AGENT="TrackRecord your-name your-email@example.com"

# Optional: require `Authorization: Bearer <token>` on API requests.
# TR_API_TOKEN=change-me

# Optional: how far back to sync filings (default 2021-01-01).
# TR_HISTORY_START=2021-01-01

# LLM API key (Anthropic), for promise extraction. Without a key, extraction is skipped.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: hard monthly cap on LLM spend in USD (default 30).
# TR_LLM_MONTHLY_BUDGET_USD=30

# Optional: model and effort for extraction (defaults claude-haiku-5-5, medium).
# TR_EXTRACTION_MODEL=claude-haiku-5-5
# TR_EXTRACTION_EFFORT=medium
